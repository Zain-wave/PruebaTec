# ---------------------------------------------------------------------------
# Este archivo documenta TODOS los secretos del proyecto. Nunca subas el .env real.
# ---------------------------------------------------------------------------

# --- Dashboard (Next.js / Vercel): variables de entorno de servidor ---------
SUPABASE_URL=https://ufrxxzrbakoaiqzzocds.supabase.co
SUPABASE_ANON_KEY=               # clave "anon": solo lectura gracias a RLS

# --- n8n Cloud: NO se leen de un .env; se cargan en n8n > Credentials ------
# (n8n Cloud no admite variables de entorno; se listan aquí para documentarlas)
GMAIL_USER=tu.correo@gmail.com
GMAIL_APP_PASSWORD=              # contraseña de aplicación de 16 caracteres (requiere verificación en 2 pasos)
SUPABASE_SERVICE_ROLE_KEY=       # credencial "Custom Auth": apikey + Authorization: Bearer <service_role>. SOLO en n8n, jamás en el front
GEMINI_API_KEY=                  # credencial "Header Auth": nombre=x-goog-api-key
ALLOWED_SENDER=remitente@ejemplo.com   # edítalo en el nodo "Filtrar remitente..." Y en el filtro FROM del trigger IMAP

# --- Conexión directa a Postgres (OPCIONAL: solo para scripts/apply_schema.sh) ---
# Copia este archivo a .env (ya está en .gitignore) y pon tu contraseña SOLO allí.
# Si tu red no tiene IPv6 y falla, usa el "Session pooler" que muestra el botón Connect de Supabase.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.ufrxxzrbakoaiqzzocds.supabase.co:5432/postgres
